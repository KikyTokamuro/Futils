{
    "name": "kikytokamuro/futils",
    "description": "Functional utils",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Kikytokamuro\\Futils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kikytokamuro\\Futils\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Daniil Archangelsky",
            "email": "kiky.tokamuro@yandex.ru"
        }
